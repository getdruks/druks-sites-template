---
import { Image } from "astro:assets";

import { site } from "../content/site";
---

<section class="section section-shell gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="section-heading">
    <h2 id="gallery-title">{site.gallery.title}</h2>
    <p>{site.gallery.introduction}</p>
  </div>
  <div class="gallery-grid">
    {site.gallery.images.map((image, index) => (
      <figure class="placeholder-media">
        <Image
          src={image.src}
          alt={image.alt}
          widths={[320, 480, 720, 960]}
          sizes="(max-width: 599px) 100vw, (max-width: 999px) 50vw, 33vw"
          format="webp"
          loading="lazy"
          quality={78}
        />
        <figcaption>
          <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
          {image.caption}
        </figcaption>
      </figure>
    ))}
  </div>
</section>
