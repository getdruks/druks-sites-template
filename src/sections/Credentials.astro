---
import { site } from "../content/site";
---

<section class="section section-shell credentials" id="credentials" aria-labelledby="credentials-title">
  <div class="section-heading">
    <h2 id="credentials-title">{site.credentials.title}</h2>
    <p>{site.credentials.introduction}</p>
  </div>
  <ul class="credential-list">
    {site.credentials.items.map((credential) => (
      <li>
        <svg aria-hidden="true" viewBox="0 0 32 32" fill="none">
          <path d="M16 3 27 9v8c0 6-4.7 10.1-11 12C9.7 27.1 5 23 5 17V9l11-6Z" />
          <path d="m11 16 3.2 3.2L21.5 12" />
        </svg>
        <div>
          <h3>{credential.title}</h3>
          <p>{credential.detail}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
